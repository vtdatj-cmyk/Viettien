-- HỆ THỐNG LOGIC VÀ CHỨC NĂNG CỐT LÕI
local function registerPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        if isValidPrompt(prompt) then
            prompt.HoldDuration = 0
            prompt.MaxActivationDistance = 15 
            table.insert(allPrompts, prompt)
        end
        
        prompt.Destroying:Connect(function()
            local idx = table.find(allPrompts, prompt)
            if idx then
                table.remove(allPrompts, idx)
            end
        end)
    end
end

for _, desc in ipairs(Workspace:GetDescendants()) do
    registerPrompt(desc)
end
Workspace.DescendantAdded:Connect(registerPrompt)

local turnOffScript
local startScript

turnOffScript = function()
    currentState = "OFF"
    waitingForPromptToMove = false
    if tpConnection then
        tpConnection:Disconnect()
        tpConnection = nil
    end
end

startScript = function()
    turnOffScript() 
    currentState = "AUTO_TP"
    
    tpConnection = RunService.Heartbeat:Connect(function()
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            character:PivotTo(CFrame.new(TARGET_POSITION))
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if currentState ~= "OFF" then
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local rootPos = character.HumanoidRootPart.Position
            
            for _, prompt in ipairs(allPrompts) do
                if prompt.Parent and prompt.Enabled and isValidPrompt(prompt) then
                    local part = prompt.Parent
                    if part:IsA("BasePart") then
                        local dist = (rootPos - part.Position).Magnitude
                        if dist <= prompt.MaxActivationDistance then
                            prompt:InputHoldBegin()
                            prompt:InputHoldEnd()
                        end
                    end
                end
            end
        end
    end
end)

ProximityPromptService.PromptShown:Connect(function(prompt)
    if isValidPrompt(prompt) then
        prompt.HoldDuration = 0
        if currentState ~= "OFF" and prompt.Enabled then
            task.spawn(function()
                prompt:InputHoldBegin()
                task.wait() 
                prompt:InputHoldEnd()
            end)
        end
    end
end)

ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, triggeredPlayer)
    if triggeredPlayer == player and (currentFarmMode ~= 0) and isValidPrompt(prompt) then
        if currentState == "OFF" then
            startScript()
        end
    end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt, triggeredPlayer)
    if triggeredPlayer == player and isValidPrompt(prompt) then
        
        if (currentFarmMode ~= 0) and currentState == "OFF" then
            startScript()
        end

        if waitingForPromptToMove then
            waitingForPromptToMove = false 
            
            task.wait(0.5)
            
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char:PivotTo(CFrame.new(FINAL_POSITION))
                
                task.wait(1.5)
                turnOffScript()
            end
        end
    end
end)

local function onCharacterAdded(character)
    local humanoid = character:WaitForChild("Humanoid")

    if currentState == "WAIT_RESPAWN" then
        currentState = "FARM_DEATH_SPOT"
        
        task.wait(0.5)
        if character and character:FindFirstChild("HumanoidRootPart") then
            character:PivotTo(CFrame.new(RESPAWN_POSITION))
        end
        
        task.wait(0.6)
        
        if currentState == "FARM_DEATH_SPOT" and character and character:FindFirstChild("HumanoidRootPart") then
            character:PivotTo(CFrame.new(FINAL_POSITION))
            
            task.wait(1)
            turnOffScript()
        end
    end

    humanoid.Died:Connect(function()
        if currentState == "AUTO_TP" or currentState == "FARM_DEATH_SPOT" then
            currentState = "WAIT_RESPAWN"
            waitingForPromptToMove = false
            if tpConnection then
                tpConnection:Disconnect()
                tpConnection = nil
            end
        end
    end)
end

if player.Character then
    onCharacterAdded(player.Character)
end
player.CharacterAdded:Connect(onCharacterAdded)
